#include <windows.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/icons/qbinedit.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@CMAKE_CURRENT_SOURCE_DIR@/resources/qbinedit.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @QBE_VERSION_COMMA@
PRODUCTVERSION  @QBE_VERSION_COMMA@
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "SAISAI.Dev\0"
            VALUE "FileDescription",  "qBinEdit - Firmware Binary Viewer/Editor\0"
            VALUE "FileVersion",      "@PROJECT_VERSION@.0\0"
            VALUE "InternalName",     "qBinEdit\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 SAISAI.Dev\0"
            VALUE "OriginalFilename", "qBinEdit.exe\0"
            VALUE "ProductName",      "qBinEdit\0"
            VALUE "ProductVersion",   "@PROJECT_VERSION@.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
